{
  "name": "orbe",
  "private": true,
  "version": "0.3.2",
  "description": "ORBE – La salida es colectiva. Arcade cooperativo para dos jugadores que juegan con el cuerpo.",
  "author": "ORBE",
  "homepage": "https://juangithub123.github.io/ORBE/",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/preparar-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/preparar-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:electron": "node scripts/preparar-mediapipe.mjs",
    "build:electron": "tsc --noEmit && vite build --mode electron",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "escritorio": "npm run build:electron && electron .",
    "escritorio:kiosco": "npm run build:electron && electron . --kiosco",
    "dist": "npm run build:electron && electron-builder --publish never",
    "dist:win": "npm run build:electron && electron-builder --win --publish never",
    "dist:mac": "npm run build:electron && electron-builder --mac --publish never",
    "dist:linux": "npm run build:electron && electron-builder --linux --publish never",
    "kinect:simular": "node scripts/simular-kinect.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@types/node": "24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "phaser": "4.2.1",
    "tone": "15.1.22",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.18.3"
  }
}
